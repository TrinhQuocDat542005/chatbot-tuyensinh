# Compose reads PORT/ACTION_PORT as localhost host ports; internal ports stay 5005/5055.
# Native shell scripts read exported variables; Rasa does not load .env itself.
PORT=5005
ACTION_PORT=5055
MODEL_PATH=models/admissions-week4.tar.gz
# serve_web.py reads this; Compose web uses its internal rasa hostname.
RASA_URL=http://127.0.0.1:5005
# Set only when calling the REST webhook from a browser.
# CORS_ORIGIN=http://localhost:5173
