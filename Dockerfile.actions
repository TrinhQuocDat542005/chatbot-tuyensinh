FROM python:3.10-slim-bookworm AS runtime
ENV PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-lock.actions.txt ./
RUN python -m pip install --no-cache-dir pip==24.0 \
    && python -m pip install --no-cache-dir -r requirements-lock.actions.txt \
    && python -m pip check
COPY actions ./actions
COPY scripts/smoke_actions.py ./scripts/smoke_actions.py
CMD ["python", "-m", "rasa_sdk", "--actions", "actions", "--port", "5055"]

FROM runtime AS checks
COPY requirements-actions.txt requirements-check.txt requirements-check.linux.txt ./
RUN python -m pip install --no-cache-dir -r requirements-check.linux.txt && python -m pip check
COPY . .
CMD ["python", "-m", "pytest", "-q"]
